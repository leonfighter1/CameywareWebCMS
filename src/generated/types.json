    {
      "name": "space_before",
      "label": "上方留白",
      "kind": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "按类型默认" },
        { "value": "none", "label": "无" },
        { "value": "small", "label": "小" },
        { "value": "medium", "label": "中" },
        { "value": "large", "label": "大" }
      ]
    }
  ],
