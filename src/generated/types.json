{
  "_readme": "The CMS's block types: each one's view is src/cms/views/<type>.tsx, its fields are what the CMS (C:\\CameywareWebCMS) shows in its editor and checks on save and upload. Field kinds: text, textarea, html (sanitised: no scripts), code (freeform's HTML, scripts allowed, shown in a sandboxed frame), link (a page path or a full address), image (a path under the site or a full address), select, boolean, icon, work (one of the works), list (of the fields under it). localized: one value per language. label_en / description_en / hint_en: the CMS's English (its interface in English). A new type: its view, its entry here, then npm run sync in the CMS.",
  "rich_text_allow": {
    "_readme": "What an html field may hold (sanitize-html's options), in the CMS on save and upload, and in the site's build: headings, text, lists, links, a few marks; no scripts, no styles. Elements may carry data-when=\"server\" and data-testid, and these classes.",
    "allowedTags": [
      "h2",
      "h3",
      "p",
      "br",
      "strong",
      "em",
      "b",
      "i",
      "u",
      "a",
      "ul",
      "ol",
      "li",
      "blockquote",
      "code",
      "span",
      "hr"
    ],
    "allowedAttributes": {
      "*": ["data-when", "data-testid", "class"],
      "a": ["href", "target", "rel"]
    },
    "allowedClasses": { "*": ["cms-big", "cms-dimmed"] },
    "allowedSchemes": ["http", "https", "mailto", "tel"]
  },
